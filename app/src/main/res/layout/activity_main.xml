<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Show ☝ one finger (index up) to the front camera to go to the next reel. Lower your hand, then show it again for the next one. The camera turns off automatically when Instagram is closed or the phone is locked." />

        <!-- Step 1 -->
        <TextView
            android:id="@+id/cameraStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/grantCameraButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Grant camera permission" />

        <!-- Step 2 -->
        <TextView
            android:id="@+id/accessibilityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Enable accessibility service" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="If the toggle is greyed out (&quot;Restricted setting&quot;): open App info → ⋮ menu → Allow restricted settings, then try again."
            android:textSize="12sp" />

        <Button
            android:id="@+id/appInfoButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open App info" />

        <!-- Settings -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/instagramOnlySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Only work inside Instagram (saves battery)" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/allowPreviousSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✌ two fingers = previous reel" />

        <!-- Step 3 -->
        <Button
            android:id="@+id/startStopButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/openInstagramButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Open Instagram" />
    </LinearLayout>
</ScrollView>
